# Demo login goes to the platform POST /v1/auth/tenant endpoint.
# Vite no longer mints JWTs or handles /v1/auth/login.
VITE_SECURITY_URL=http://localhost:18081

# Real /v1 transport for the demo. Leave false/unset for the mock shell.
VITE_REAL_API=true
VITE_API_BASE=
VITE_SYNFLUX_URL=http://192.168.10.30:30090
VITE_SYNQUEST_URL=http://192.168.10.30:30083

# Client-visible username/tenant prefill hints. No password, no secret.
VITE_DEMO_AUTH_USER=
VITE_DEMO_AUTH_TENANT=
