# Development-only authentication placeholder (Vite dev server).
# These are server-side values; do not commit real credentials or secrets.
# If any of USER, PASSWORD, TENANT or SYNANTON_JWT_SECRET is unset, the login
# endpoint returns 503 DEMO_AUTH_NOT_CONFIGURED.
DEMO_AUTH_USER=
DEMO_AUTH_PASSWORD=
DEMO_AUTH_TENANT=
SYNANTON_JWT_SECRET=

# Optional JWT identity claims. Omitted from the token when unset.
DEMO_AUTH_UID=
DEMO_AUTH_GIDS=

# Client-visible prefill hints. Never put the password in a VITE_* variable.
VITE_DEMO_AUTH_USER=
VITE_DEMO_AUTH_TENANT=
